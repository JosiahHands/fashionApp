{
  "name": "fashionapp",
  "version": "1.0.0",
  "description": "Save and organize your wardrobe: items, what goes with what, outfits, and occasions. Runs on Cloudflare Workers with D1.",
  "dependencies": {
    "hono": "4.13.14",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@eslint/js": "9.39.1",
    "@swc/core": "1.16.13",
    "@swc/jest": "0.2.39",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/jest": "30.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "identity-obj-proxy": "3.0.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "^7.0.0",
    "wrangler": "^4.156.0"
  },
  "private": true,
  "scripts": {
    "build": "tsc -b && vite build",
    "cf-typegen": "wrangler types",
    "check": "tsc && vite build && wrangler deploy --dry-run",
    "db:migrate:local": "wrangler d1 migrations apply fashionapp-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply fashionapp-db --remote",
    "deploy": "wrangler deploy",
    "dev": "vite",
    "lint": "eslint .",
    "preview": "npm run build && vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "coverage:preview": "open coverage/lcov-report/index.html"
  },
  "type": "module"
}
